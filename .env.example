# --- Sécurité (OBLIGATOIRE en prod) ---
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SCORING_JWT_SECRET=remplacer-par-une-cle-aleatoire-de-64-caracteres

# Mot de passe du compte admin par défaut
SCORING_ADMIN_PASSWORD=RemplacerParUnMotDePasseFort!

# --- Oracle ---
ORACLE_USER=votre_user_oracle
