# ============================================================
# Dockerfile — Frontend Angular 19 (nginx)
# Stage 1 : build Angular en production
# Stage 2 : servir les fichiers statiques via nginx
# ============================================================

# ---- Stage 1 : builder Node ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copier manifestes de dépendances en premier (cache Docker)
COPY scoring-app/package.json scoring-app/package-lock.json ./

RUN npm ci --legacy-peer-deps

# Copier le reste du code source Angular
COPY scoring-app/ .

# Build production
RUN npm run build -- --configuration production

# ---- Stage 2 : runtime nginx ----
FROM nginx:1.27-alpine AS runtime

# Supprimer la config nginx par défaut
RUN rm /etc/nginx/conf.d/default.conf

# Copier notre configuration nginx (SPA : toutes les routes → index.html)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copier le build Angular
COPY --from=builder /app/dist/scoring-app/browser /usr/share/nginx/html

# Utilisateur non-root
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:80 || exit 1

CMD ["nginx", "-g", "daemon off;"]
